# Copy to `.env` and edit. cloud/config.py reads this file without extra deps.
# Values shown are the built-in defaults.

# ---------------------------------------------------------------- MQTT broker
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TLS=false
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=gridshield-cloud
MQTT_TOPIC_PREFIX=smart_grid

# ------------------------------------------------------------------- storage
# SQLite file used by the ingestor, simulator and dashboard.
GRIDSHIELD_DB=data/gridshield.db
NODE_OFFLINE_SECONDS=15
RETENTION_DAYS=30

# -------------------------------------------------------------- analytics
ANOMALY_ROLLING_WINDOW=20
ALERT_COOLDOWN_SECONDS=300

# ---------------------------------------------------------------- dashboard
# Default map centre (New Delhi). node coordinates come from config/nodes.json.
SITE_LAT=28.6139
SITE_LON=77.2090
SITE_ZOOM=11

# ------------------------------------------------- safety envelope (Volts/Amps)
# Must stay in sync with firmware/arduino/gridshield_node/config.h.
# tests/test_firmware_contract.py fails if the two drift apart.
I_TRIP_A=12.0
V_MIN_TRIP=180.0
V_MAX_TRIP=270.0
I_RESET_A=10.5
V_RESET_MIN=190.0
V_RESET_MAX=250.0
TRIP_CONFIRM_SAMPLES=3
RESET_CONFIRM_SAMPLES=5
AI_TRIP_CONFIDENCE=0.85
